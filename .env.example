# ThrottleGuard — Environment Variables
# Copy this file to .env for local dev. Set these in Railway for production.
# NEVER commit .env to source control.

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string.
# Stores user accounts (tg_users) and prediction history (tg_predictions).
# Tables are created automatically on first launch.
# On Railway: Settings → Variables → add DATABASE_URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Default admin account password — created on first launch if no users exist.
# Change this immediately after first login via the User Management panel.
# On Railway: Settings → Variables → add TG_ADMIN_PASSWORD
TG_ADMIN_PASSWORD=ChangeMe_OnFirstLogin!

# Stripe — required for subscription billing
# Get these from dashboard.stripe.com → Developers → API Keys
# Use sk_test_ / pk_test_ keys during development, sk_live_ / pk_live_ in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Motive ingestion API (api.py — separate Railway service) ──────────────────

# Required before /authorize can be used. Gates the Motive OAuth connect flow
# so only the fleet operator can (re)link the Motive integration — without it,
# anyone who finds the URL could connect their own Motive account and
# overwrite the fleet's stored token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MOTIVE_SETUP_KEY=your-random-setup-key-here

# ── Optional ──────────────────────────────────────────────────────────────────

# Not currently used by ThrottleGuard (used by Fleet Optimizer).
# Leave blank or omit unless integrating with Fleet Optimizer session auth.
# SESSION_SECRET=your-random-secret-here

# HubSpot private app token — enables tg_hubspot_sync.py to push trial-start
# events into HubSpot (sets a contact's trial_start_date property), which
# the tg-trial-followup GitHub Actions workflow reads to draft follow-up
# tasks. Leave unset and trial signups just won't sync — ThrottleGuard
# still works fully standalone either way.
# Create at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
# NOTE: this is a SEPARATE value from the GitHub Actions secret of the same
# name — set it here too (Railway → Streamlit service → Variables) if you
# want live trial signups to sync, not just the daily follow-up check.
# HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-...
